# ----------------------------------------------------
# React Native / Mobile .gitignore
# ----------------------------------------------------

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment & Local Configurations
.env
.env.local
.env.*.local
local.properties

# Android Build Artifacts & Caches
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/app/.cxx/
android/.kotlin/
android/*.iml
android/**/*.iml
.cxx/
*.hprof

# Android Keystores (keep debug keystore only)
*.keystore
*.jks
!android/app/debug.keystore

# Android Binary Outputs (do not commit multi-megabyte APK/AABs)
*.apk
*.aab

# iOS Build Artifacts & CocoaPods
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/.xcode.env.local
*.ipa
*.hmap
*.xcuserstate

# Metro Bundler & JS Bundles
.metro-health-check*
*.jsbundle

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Testing & Coverage
coverage/
.nyc_output/

# OS & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
