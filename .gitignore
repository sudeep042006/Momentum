# Root .gitignore for Momentum Monorepo

# Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets
.env
.env.local
.env.*.local
*.env

# Mobile Android & iOS Build Artifacts
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/.cxx/
mobile/android/app/.cxx/
mobile/android/local.properties
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/DerivedData/
*.apk
*.aab

# Web Build Outputs
web/dist/
web/build/

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
